# ============================================================
# 生产环境变量模板 —— 复制为 .env 后填入真实值
#   cp .env.example .env
# ⚠️ .env 含密钥，已被 .gitignore 排除，切勿提交 / 打进镜像层
# ⚠️ 本文件内的值 docker compose 按字面量读取（不展开 ${} 引用），
#    镜像地址须写完整：仓库/命名空间/应用:tag
# ============================================================

# ---- 私有镜像仓库 ----
# 阿里云 ACR 个人版形如 crpi-xxxxxxxx.cn-hangzhou.personal.cr.aliyuncs.com
# 同一仓库用 tag 区分服务（:backend / :frontend）
REGISTRY=<your-registry>
BACKEND_IMAGE=<your-registry>/<your-namespace>/myapp:backend
FRONTEND_IMAGE=<your-registry>/<your-namespace>/myapp:frontend

# ---- 应用 ----
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=<change-me>
JWT_EXPIRE_HOURS=8
ADMIN_USERNAME=<change-me>
ADMIN_PASSWORD=<change-me>
CORS_ORIGINS=https://example.com,https://www.example.com

# ---- 运维探活（可选：跨机监控地址，如 WireGuard 隧道对端）----
OPS_MONITOR_URL=http://10.10.0.2:9090

# ---- 宿主路径（服务器绝对路径，来自 01-preflight 实测）----
HOST_DATA_DIR=/opt/myapp/data
HOST_BACKUP_DIR=/opt/myapp/backup
HOST_OOM_DIR=/opt/myapp/oom
HOST_CERT_DIR=/etc/letsencrypt
HOST_CERTBOT_DIR=/opt/myapp/certbot

# ---- 文件属主（对齐宿主上旧服务账号的实际 uid/gid，各机不同！）----
# 例：旧服务是发行版包安装的 tomcat，其 uid 往往是 987；用 id <user> 查
APP_UID=987
APP_GID=987

# ---- 资源 ----
MEM_LIMIT=512m
