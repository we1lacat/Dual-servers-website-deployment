# ============================================================
# 前端多阶段构建模板（SPA：node 构建 → nginx 烘焙）
# 构建上下文 = 前端工程根目录：
#   docker build -t myapp-frontend:local -f Dockerfile .
# ============================================================

# ---- 阶段 1：构建 ----
FROM node:20-alpine AS build
WORKDIR /app

# 先拷依赖清单，利用层缓存（依赖不变时改源码不重装）
COPY package.json package-lock.json ./
RUN npm ci

# 再拷源码并构建
COPY . .
RUN npm run build

# ---- 阶段 2：运行态 ----
FROM nginx:1.27-alpine

# 清掉默认站点，避免与挂载的自定义配置冲突
# （compose 会挂载 nginx-default.conf 覆盖此文件）
RUN rm -f /etc/nginx/conf.d/default.conf

# 烘焙静态产物；SPA history 回退 / 缓存策略由挂载的配置决定
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
